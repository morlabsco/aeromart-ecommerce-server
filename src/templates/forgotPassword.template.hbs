<html lang="en">

    <head>
        <meta charset="UTF-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Your AeroMart verification code</title>
    </head>

    <body style="margin:0;padding:0;background-color:#FAF3E7;font-family:Arial,Helvetica,sans-serif;">
        <!-- Colors mirror the storefront design tokens (app/globals.css):
             brand orange #f0512e, charcoal #232323, cream #FAF3E7. -->

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#FAF3E7;padding:32px 16px;">
            <tr>
                <td align="center">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background-color:#ffffff;border-radius:14px;overflow:hidden;">

                        <!-- Brand header -->
                        <tr>
                            <td align="center" style="padding:32px 32px 8px 32px;">
                                {{#if logoUrl}}
                                <img src="{{logoUrl}}" alt="AeroMart" style="display:block;height:40px;width:auto;max-width:180px;object-fit:contain;" />
                                {{else}}
                                <span style="font-size:24px;font-weight:bold;color:#232323;letter-spacing:0.5px;">Aero<span style="color:#f0512e;">Mart</span></span>
                                {{/if}}
                            </td>
                        </tr>
                        <tr>
                            <td align="center" style="padding:0 32px 24px 32px;">
                                <span style="display:block;width:48px;height:4px;border-radius:999px;background-color:#f0512e;"></span>
                            </td>
                        </tr>

                        <!-- Heading -->
                        <tr>
                            <td align="center" style="padding:0 32px;">
                                <h1 style="margin:0;font-size:22px;line-height:1.3;color:#232323;">Password reset requested</h1>
                            </td>
                        </tr>

                        <!-- Body copy -->
                        <tr>
                            <td style="padding:16px 32px 0 32px;">
                                <p style="margin:0;font-size:15px;line-height:1.6;color:#555555;">
                                    Hi <strong style="color:#232323;">{{userName}}</strong>,
                                </p>
                                <p style="margin:12px 0 0 0;font-size:15px;line-height:1.6;color:#555555;">
                                    Use the 6-digit code below to continue resetting your password.
                                    The code is valid for the next <strong style="color:#232323;">5 minutes</strong>.
                                </p>
                            </td>
                        </tr>

                        <!-- OTP code -->
                        <tr>
                            <td align="center" style="padding:24px 32px 8px 32px;">
                                <div style="display:inline-block;background-color:#FAF3E7;border:1px solid #efe3cd;border-radius:10px;padding:14px 28px;">
                                    <span style="font-size:28px;font-weight:bold;letter-spacing:10px;color:#232323;">{{otpCode}}</span>
                                </div>
                            </td>
                        </tr>

                        <!-- CTA -->
                        <tr>
                            <td align="center" style="padding:20px 32px 8px 32px;">
                                <a href="{{appUrl}}/forgot-password"
                                   style="display:inline-block;background-color:#f0512e;color:#ffffff;font-size:15px;font-weight:bold;text-decoration:none;border-radius:8px;padding:14px 36px;">
                                    Reset password
                                </a>
                            </td>
                        </tr>
                        <tr>
                            <td align="center" style="padding:8px 32px 0 32px;">
                                <p style="margin:0;font-size:12px;line-height:1.6;color:#999999;">
                                    Button not working? Copy this link into your browser:<br />
                                    <a href="{{appUrl}}/forgot-password" style="color:#f0512e;text-decoration:none;word-break:break-all;">{{appUrl}}/forgot-password</a>
                                </p>
                            </td>
                        </tr>

                        <!-- Divider + ignore note -->
                        <tr>
                            <td style="padding:28px 32px 0 32px;">
                                <div style="border-top:1px solid #f0f0f0;"></div>
                                <p style="margin:16px 0 0 0;font-size:13px;line-height:1.6;color:#999999;">
                                    If you didn&apos;t request a password reset, you can safely ignore this
                                    email — your password will stay unchanged.
                                </p>
                            </td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td align="center" style="padding:24px 32px;background-color:#232323;">
                                <p style="margin:0;font-size:12px;color:#ffffff;font-weight:bold;letter-spacing:2px;">AEROMART</p>
                                <p style="margin:6px 0 0 0;font-size:11px;color:rgba(255,255,255,0.6);">
                                    This is an automated message — please don&apos;t reply directly.
                                </p>
                            </td>
                        </tr>

                    </table>
                </td>
            </tr>
        </table>
    </body>

</html>
